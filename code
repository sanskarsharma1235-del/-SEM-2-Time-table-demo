  );
}

// --- DASHBOARD COMPONENT ---
function Dashboard({ subjects, progress, weeklyPlan, timetable }) {
  const [strategy, setStrategy] = useState(null);
  const [isGenerating, setIsGenerating] = useState(false);

  const totalTopics = subjects.reduce((acc, s) => acc + s.units.reduce((uAcc, u) => uAcc + u.topics.length, 0), 0);
  const finishedTopics = Object.values(progress).reduce((acc, topics) => acc + topics.length, 0);
  const overallProgress = totalTopics ? Math.round((finishedTopics / totalTopics) * 100) : 0;

  const generateStrategy = async () => {
    setIsGenerating(true);
    setStrategy(null);
    try {
      const progressDetails = subjects.map(s => {
        const done = (progress[s.id] || []).length;
        const total = s.units.reduce((acc, u) => acc + u.topics.length, 0);
        return `${s.code} (${s.name}): ${done}/${total} topics completed.`;
      }).join('\n');

      const prompt = `Analyze this student's (Sanskar) current syllabus progress and generate a "Mastery Strategy ✨". 
      Progress Data:
      ${progressDetails}
      
      Identify the 2 subjects needing the most attention and provide a 3-step actionable study plan for this week. Keep it punchy and academic. Start with a structured "High Priority" header.`;
      
      const res = await callGemini(prompt);
      setStrategy(String(res));
    } catch (e) {
      setStrategy("Error generating strategy. Check connection.");
    } finally {
      setIsGenerating(false);
    }
  };

  const today = new Date().toLocaleDateString('en-US', { weekday: 'short' });
  const todaysClasses = Object.entries(timetable)
    .filter(([key]) => key.startsWith(today))
    .sort()
    .map(([key, code]) => ({ time: key.split('-')[1], sub: subjects.find(s => s.code === code) }));

  return (
    <div className="space-y-8 pb-20">
      <div className="flex justify-between items-end">
        <div>
          <h2 className="text-4xl font-black tracking-tight mb-2">Workspace Overview</h2>
          <p className="text-slate-500 dark:text-slate-400 font-medium italic">Empowered by Gemini Assistant ✨</p>
        </div>
        <div className="hidden md:flex gap-4">
           <CardStat label="Overall Course" value={`${overallProgress}%`} subLabel="Syllabus Done" />
           <CardStat label="Subjects Active" value={subjects.length} subLabel="Linked Core" />
        </div>
      </div>

