// --- SYLLABUS TRACKER ---
function SyllabusTracker({ subjects, progress, userId }) {
  const [selectedSubject, setSelectedSubject] = useState(null);
  const [modal, setModal] = useState(null); // { type, topic, data, loading }

  const toggleTopic = async (subjectId, topic) => {
    const current = progress[subjectId] || [];
    const updated = current.includes(topic) ? current.filter(t => t !== topic) : [...current, topic];
    await setDoc(doc(db, `artifacts/${APP_ID}/users/${userId}`, 'progress', subjectId), { completedTopics: updated });
  };

  const handleAIAction = async (type, topic) => {
    setModal({ type, topic, loading: true });
    try {
      let res;
      if (type === 'explain') {
        res = await callGemini(`Explain "${topic}" from the course "${selectedSubject.name}" for a college student. Simplify complex jargon and use 3 bullet points.`);
        setModal(prev => ({ ...prev, data: String(res), loading: false }));
      } else if (type === 'quiz') {
        res = await callGemini(`Generate 3 tough multiple choice questions on "${topic}" from "${selectedSubject.name}". Format as JSON array: [{"q": "...", "o": ["A", "B", "C", "D"], "a": "correct_option"}]. No markdown.`, true);
        setModal(prev => ({ ...prev, data: res, loading: false }));
      }
    } catch (e) {
      setModal(null);
      alert(e.message);
    }
  };

  return (
    <div className="space-y-8 h-full flex flex-col">
       <div className="flex justify-between items-center">
        <h2 className="text-3xl font-black tracking-tight">Curriculum Tracker</h2>
        <div className="flex items-center gap-2 text-indigo-600 font-bold text-sm">
          <Sparkles size={16} /> Powered by Gemini
        </div>
      </div>

      <div className="flex-1 flex gap-8 overflow-hidden">
        <div className="w-80 space-y-4 overflow-y-auto pr-2 custom-scrollbar">
          {subjects.map(sub => (
            <button 
              key={sub.id}
              onClick={() => setSelectedSubject(sub)}
              className={`w-full text-left p-6 rounded-2xl border transition-all relative overflow-hidden group ${
                selectedSubject?.id === sub.id 
                  ? `border-${sub.color}-500 bg-white dark:bg-slate-800 shadow-xl` 
                  : 'bg-white dark:bg-slate-800 border-slate-200 dark:border-slate-700'
              }`}
            >
              <div className={`absolute left-0 top-0 bottom-0 w-1.5 bg-${sub.color}-500`} />
              <span className="font-black text-lg">{sub.code}</span>
              <p className="text-sm font-bold text-slate-500 dark:text-slate-400 truncate">{sub.name}</p>
            </button>
          ))}
        </div>

        <div className="flex-1 bg-white dark:bg-slate-800 rounded-3xl border border-slate-200 dark:border-slate-700 p-8 overflow-y-auto custom-scrollbar">
          {selectedSubject ? (
            <div className="space-y-8 animate-fade-in">
              <h3 className="text-2xl font-black">{selectedSubject.name}</h3>
              {selectedSubject.units.map((unit, uIdx) => (
                <div key={uIdx} className="space-y-4">
                  <h4 className="text-sm font-black text-slate-400 uppercase tracking-widest border-b border-slate-100 dark:border-slate-700 pb-2">{unit.title}</h4>
                  <div className="grid grid-cols-1 md:grid-cols-2 gap-3">
                    {unit.topics.map((topic, tIdx) => {
                      const isDone = (progress[selectedSubject.id] || []).includes(topic);
                      return (
                        <div key={tIdx} className={`p-4 rounded-2xl border transition-all flex items-center justify-between group ${isDone ? 'bg-emerald-50 dark:bg-emerald-900/10 border-emerald-100' : 'bg-slate-50 dark:bg-slate-700/30 border-slate-100'}`}>
                          <div className="flex items-center gap-3">
                             <button onClick={() => toggleTopic(selectedSubject.id, topic)} className={`w-6 h-6 rounded-lg border-2 flex items-center justify-center ${isDone ? 'bg-emerald-500 border-emerald-500 text-white' : 'bg-white dark:bg-slate-600 border-slate-300'}`}>
                                {isDone && <CheckCircle2 size={14} />}
                             </button>
                             <span className={`text-sm font-bold ${isDone ? 'text-slate-400 line-through' : ''}`}>{topic}</span>
                          </div>
                          <div className="flex gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
                             <button onClick={() => handleAIAction('explain', topic)} title="AI Explain ✨" className="p-2 text-indigo-400 hover:bg-white dark:hover:bg-slate-600 rounded-xl"><Sparkles size={14} /></button>
                             <button onClick={() => handleAIAction('quiz', topic)} title="Quiz Master ✨" className="p-2 text-purple-400 hover:bg-white dark:hover:bg-slate-600 rounded-xl"><Zap size={14} /></button>
                          </div>
                        </div>
                      )
                    })}
                  </div>
                </div>
              ))}
            </div>
          ) : (
            <div className="h-full flex items-center justify-center text-slate-400 font-bold">Select a subject to begin</div>
          )}
        </div>
      </div>

      {modal && (
        <div className="fixed inset-0 bg-slate-900/60 backdrop-blur-md z-[60] flex items-center justify-center p-4">
           <GlassCard className="max-w-xl w-full p-8 relative overflow-hidden">
              <button onClick={() => setModal(null)} className="absolute top-4 right-4 text-slate-400 hover:text-slate-900"><X size={20}/></button>
              <h3 className="font-black text-xl mb-4 flex items-center gap-2">
                {modal.type === 'explain' ? <Sparkles className="text-indigo-500" /> : <Zap className="text-purple-500" />}
                {modal.type === 'explain' ? 'Concept Explanation' : 'Quick Quiz ✨'}
              </h3>
              <p className="text-xs font-black text-slate-500 uppercase mb-4">{modal.topic}</p>
              
              {modal.loading ? (
                <div className="py-12 flex flex-col items-center gap-4 text-indigo-500">
                   <Loader2 className="animate-spin w-10 h-10" />
                   <span className="font-bold animate-pulse">Consulting AI Knowledge Base...</span>
                </div>
              ) : (
                <div className="max-h-[60vh] overflow-y-auto pr-2 custom-scrollbar">
                   {modal.type === 'explain' ? (
                     <div className="text-slate-700 dark:text-slate-300 leading-relaxed font-medium whitespace-pre-wrap">{String(modal.data)}</div>
                   ) : (
                     <div className="space-y-6">
                        {Array.isArray(modal.data) && modal.data.map((q, i) => (
                           <div key={i} className="p-4 bg-slate-50 dark:bg-slate-700 rounded-2xl">
                              <p className="font-bold text-sm mb-3">Q{i+1}: {q.q}</p>
                              <div className="grid grid-cols-1 gap-2">
                                 {Array.isArray(q.o) && q.o.map((o, j) => (
                                    <button key={j} className="text-left px-4 py-2 bg-white dark:bg-slate-600 hover:bg-indigo-50 dark:hover:bg-slate-500 rounded-xl text-xs font-medium border border-slate-100 transition-colors">
                                       {o}
                                    </button>
                                 ))}
                              </div>
                           </div>
                        ))}
                     </div>
                   )}
                </div>
              )}
           </GlassCard>
        </div>
      )}
    </div>
  );
}

// --- NOTES WALL ---
function NotesWall({ subjects, notes, userId }) {
  const [isAdding, setIsAdding] = useState(false);
  const [noteForm, setNoteForm] = useState({ title: '', content: '', subjectId: '', color: 'yellow' });
  const [optimizingId, setOptimizingId] = useState(null);

  const saveNote = async () => {
    if (!noteForm.title.trim()) return;
    await addDoc(collection(db, `artifacts/${APP_ID}/users/${userId}`, 'notes'), { ...noteForm, createdAt: serverTimestamp() });
    setNoteForm({ title: '', content: '', subjectId: '', color: 'yellow' });
    setIsAdding(false);
  };

  const deleteNote = (id) => deleteDoc(doc(db, `artifacts/${APP_ID}/users/${userId}`, 'notes', id));

  const optimizeNote = async (note) => {
    setOptimizingId(note.id);
    try {
      const prompt = `Refine this student note into a high-quality summary. Note Title: "${note.title}". Content: "${note.content}". 
      Clean up grammar, use bullet points if needed, and make it professional. Output only the refined content.`;
      const res = await callGemini(prompt);
      await updateDoc(doc(db, `artifacts/${APP_ID}/users/${userId}`, 'notes', note.id), { content: String(res) });
    } catch (e) {
      alert("AI optimization failed.");
    } finally {
      setOptimizingId(null);
    }
  };

  const colors = {
    yellow: "bg-yellow-50 dark:bg-yellow-900/20 border-yellow-200 dark:border-yellow-900/40",
    indigo: "bg-indigo-50 dark:bg-indigo-900/20 border-indigo-200 dark:border-indigo-900/40",
    emerald: "bg-emerald-50 dark:bg-emerald-900/20 border-emerald-200 dark:border-emerald-900/40",
    rose: "bg-rose-50 dark:bg-rose-900/20 border-rose-200 dark:border-rose-900/40"
  };

  return (
    <div className="h-full flex flex-col space-y-6">
       <div className="flex justify-between items-center">
          <h2 className="text-3xl font-black tracking-tight">Sticky Wall</h2>
          <Button onClick={() => setIsAdding(true)} size="lg"><Plus size={20}/> Add Note</Button>
       </div>

       <div className="flex-1 overflow-y-auto custom-scrollbar pb-20">
          <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
             {notes.map(note => {
               const sub = subjects.find(s => s.id === note.subjectId);
               return (
                 <div key={note.id} className={`p-6 rounded-3xl border shadow-sm flex flex-col min-h-[220px] group relative animate-fade-in ${colors[note.color] || colors.yellow}`}>
                    <div className="flex justify-between items-start mb-4">
                       <h4 className="font-black text-lg leading-tight text-slate-800 dark:text-slate-100">{note.title}</h4>
                       <div className="flex gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
                         <button 
                            onClick={() => optimizeNote(note)} 
                            disabled={optimizingId === note.id}
                            className={`p-2 rounded-lg hover:bg-white/50 text-indigo-600 ${optimizingId === note.id ? 'animate-spin' : ''}`}
                            title="Optimize ✨"
                         >
                            {optimizingId === note.id ? <Loader2 size={16}/> : <Wand2 size={16}/>}
                         </button>
                         <button onClick={() => deleteNote(note.id)} className="p-2 text-slate-500 hover:text-red-500 transition-all"><Trash2 size={16}/></button>
                       </div>
                    </div>
                    <p className="text-sm font-medium text-slate-600 dark:text-slate-300 flex-1 whitespace-pre-wrap">{note.content}</p>
                    {sub && <span className="mt-4 text-[10px] font-black uppercase tracking-widest text-slate-400">{sub.code} Linked</span>}
                 </div>
               );
             })}
          </div>
       </div>

       {isAdding && (
         <div className="fixed inset-0 bg-slate-900/60 backdrop-blur-md z-[60] flex items-center justify-center p-4">
            <GlassCard className="max-w-md w-full p-8">
               <h3 className="font-black text-xl mb-6">Create New Note</h3>
               <div className="space-y-4">
                  <input className="w-full p-3 rounded-xl bg-slate-50 dark:bg-slate-700 border border-slate-200 text-sm font-bold" placeholder="Title..." value={noteForm.title} onChange={e => setNoteForm({...noteForm, title: e.target.value})} />
                  <textarea className="w-full h-40 p-3 rounded-xl bg-slate-50 dark:bg-slate-700 border border-slate-200 text-sm font-medium resize-none" placeholder="Write something..." value={noteForm.content} onChange={e => setNoteForm({...noteForm, content: e.target.value})} />
                  <div className="flex gap-2">
                     {Object.keys(colors).map(c => (
                        <button key={c} onClick={() => setNoteForm({...noteForm, color: c})} className={`w-8 h-8 rounded-full border-4 ${noteForm.color === c ? 'border-indigo-500 scale-110' : 'border-transparent'} ${colors[c].split(' ')[0]}`} />
                     ))}
                  </div>
                  <div className="flex gap-2 pt-4">
                     <Button variant="secondary" className="flex-1" onClick={() => setIsAdding(false)}>Cancel</Button>
                     <Button className="flex-1" onClick={saveNote}>Save Note</Button>
                  </div>
               </div>
            </GlassCard>
         </div>
       )}
    </div>
  );
}

// Helpers
const Button = ({ children, onClick, variant = "primary", className = "", disabled = false, size="md" }) => {
  const baseStyle = "rounded-lg font-bold transition-all duration-200 flex items-center justify-center gap-2 active:scale-95 disabled:opacity-50";
  const sizes = { sm: "px-3 py-1.5 text-xs", md: "px-4 py-2 text-sm", lg: "px-6 py-3 text-base" };
  const variants = {
    primary: "bg-indigo-600 text-white hover:bg-indigo-700 shadow-lg",
    secondary: "bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-700 hover:bg-slate-50",
    gemini: "bg-gradient-to-r from-indigo-500 to-purple-600 text-white shadow-xl hover:shadow-indigo-500/20"
  };
  return <button onClick={onClick} className={`${baseStyle} ${sizes[size]} ${variants[variant]} ${className}`} disabled={disabled}>{children}</button>;
};

