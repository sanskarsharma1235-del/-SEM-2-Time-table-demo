              {strategy && (
                <div className="mb-8 p-6 bg-indigo-50 dark:bg-indigo-900/20 border border-indigo-200 dark:border-indigo-800 rounded-3xl animate-fade-in text-sm text-slate-700 dark:text-slate-300 whitespace-pre-wrap">
