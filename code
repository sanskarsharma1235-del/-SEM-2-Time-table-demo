// --- AI CHAT WINDOW ---
function AiChatWindow({ subjects, onClose }) {
  const [messages, setMessages] = useState([
    { role: 'ai', text: "Hey Sanskar! I'm your Study Copilot. How can I help you with your semester today? ✨" }
  ]);
  const [input, setInput] = useState('');
  const [isLoading, setIsLoading] = useState(false);
  const scrollRef = useRef(null);

  useEffect(() => {
    scrollRef.current?.scrollIntoView({ behavior: 'smooth' });
  }, [messages]);

  const handleSend = async () => {
    if (!input.trim() || isLoading) return;
    
    const userMsg = input;
    setInput('');
    setMessages(prev => [...prev, { role: 'user', text: userMsg }]);
    setIsLoading(true);

    try {
      const subjectContext = subjects.map(s => `${s.code}: ${s.name}`).join(', ');
      const prompt = `User (Sanskar) says: "${userMsg}". 
      Context: Sanskar is in his 2nd semester taking these courses: ${subjectContext}. 
      Act as a helpful, academic, yet encouraging AI Study Copilot. 
      Help him with study tips, course-specific questions, or motivation. Keep responses concise but high-value.`;
      
      const response = await callGemini(prompt);
      setMessages(prev => [...prev, { role: 'ai', text: String(response) }]);
    } catch (e) {
      setMessages(prev => [...prev, { role: 'ai', text: e.message }]);
    } finally {
      setIsLoading(false);
    }
  };

  return (
    <div className="fixed bottom-28 right-8 w-96 h-[500px] bg-white dark:bg-slate-800 rounded-3xl border border-slate-200 dark:border-slate-700 shadow-2xl z-50 flex flex-col overflow-hidden animate-fade-in">
