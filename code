                      <div className="px-3 py-1 bg-white dark:bg-slate-600 rounded-xl text-xs font-black h-fit shadow-sm">
                        {cls.time}
                      </div>
                      <div className="flex-1">
                        <p className="font-black text-slate-800 dark:text-slate-100 text-sm">{cls.sub?.code}</p>
